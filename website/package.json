{
  "name": "skillpot-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "sync:docs": "node scripts/sync-docs.mjs",
    "check": "npm run sync:docs && astro check",
    "test": "node --test tests/unit/*.test.mjs",
    "build": "npm run check && npm test && astro build && node scripts/emit-markdown-downloads.mjs && npm run test:output",
    "test:output": "node --test tests/output.test.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/starlight": "0.42.5",
    "astro": "7.3.5",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-to-markdown": "2.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "wrangler": "4.154.0"
  }
}
