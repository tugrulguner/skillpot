---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
const resources = [
  { label: 'ModePot', href: 'https://modepot.io/' },
  { label: 'GitHub', href: 'https://github.com/tugrulguner/skillpot' },
  { label: 'Community', href: 'https://discord.gg/u3AANZr6RG' },
  { label: 'About Tugrul', href: 'https://tugrul.modepot.io/' },
];
---
<div class="header">
  <div class="title-wrapper"><img class="skillpot-mark" src="/assets/skillpot-mark.svg" alt="" width="20" height="20" /><SiteTitle /></div>
  <div class="search"><Search /></div>
  <div class="right-group">
    <nav class="family-resources" aria-label="Family resources">{resources.map((r) => <a href={r.href}>{r.label}</a>)}</nav>
    <button class="family-menu-toggle" type="button" aria-expanded="false" aria-controls="family-menu-panel">Menu</button>
    <ThemeSelect />
  </div>
  <div id="family-menu-panel" class="family-menu-panel" role="region" aria-label="Menu" hidden>
    <nav aria-label="Family resources">{resources.map((r) => <a href={r.href}>{r.label}</a>)}</nav>
    <nav aria-label="SkillPot documentation"><a href="/">Overview</a><a href="/quickstart/">Quick start</a><a href="/catalogue/">Catalogue</a><a href="/host-setup/">Host setup</a><a href="/authoring/">Authoring</a><a href="/provenance-refresh/">Provenance &amp; refresh</a><a href="/limits/">Limits</a></nav>
  </div>
</div>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.family-menu-toggle');
  const panel = document.querySelector<HTMLElement>('#family-menu-panel');
  toggle?.addEventListener('click', () => {
    if (!panel) return;
    const opening = panel.hidden;
    panel.hidden = !opening;
    toggle.setAttribute('aria-expanded', String(opening));
    if (opening) panel.querySelector('a')?.focus();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && panel && !panel.hidden) {
      panel.hidden = true;
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.focus();
    }
  });
</script>
<style>
  .header{height:100%;display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:1rem}
  .title-wrapper{display:flex;align-items:center;gap:.4rem;min-width:0}.skillpot-mark{width:20px;height:20px;flex:none}
  .title-wrapper :global(a){min-height:44px;display:flex;align-items:center}
  .family-resources,.right-group{display:flex;align-items:center;gap:.4rem}
  .family-resources a,.family-menu-toggle,.family-menu-panel a{box-sizing:border-box;min-width:44px;min-height:44px;padding:0 .5rem;display:inline-flex;align-items:center;justify-content:center;border-radius:6px;color:var(--sl-color-text);text-decoration:none}
  .family-menu-toggle{display:none;border:1px solid var(--sl-color-gray-5);background:var(--sl-color-bg);font:inherit}
  .family-resources a:hover,.family-menu-panel a:hover{background:var(--sl-color-gray-6)}
  .family-menu-panel{position:absolute;z-index:20;inset-inline:1rem;top:calc(100% + .25rem);display:grid;gap:.5rem;padding:.75rem;border:1px solid var(--sl-color-gray-5);border-radius:6px;background:var(--sl-color-bg);box-shadow:0 8px 24px #0002}
  .family-menu-panel nav{display:grid;gap:.25rem}.family-menu-panel nav+nav{padding-top:.5rem;border-top:1px solid var(--sl-color-gray-5)}.family-menu-panel[hidden]{display:none}.family-menu-panel a{justify-content:flex-start}
  :global(.header button),:global(starlight-theme-select select){min-width:44px;min-height:44px;box-sizing:border-box}
  :global(:focus-visible){outline:2px solid var(--sl-color-accent);outline-offset:2px}
  @media(max-width:50rem){.header{grid-template-columns:minmax(0,1fr) auto auto;gap:.25rem}.search{display:block;width:44px}.search :global(button){width:44px;min-width:44px;padding:0}.family-resources{display:none}.family-menu-toggle{display:inline-flex}.right-group{gap:.25rem}}
  @media(max-width:25rem){.header{gap:0}.skillpot-mark{width:20px;height:20px}.title-wrapper :global(a){font-size:18px}.family-menu-toggle{padding-inline:.25rem;font-size:14px}}
</style>
